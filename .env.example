# Agent Bridge environment configuration
# Copy to .env and edit

# This node's identity (must be unique within your mesh)
AGENT_BRIDGE_NODE_ID=mbp

# Server
AGENT_BRIDGE_HOST=127.0.0.1
AGENT_BRIDGE_PORT=8765

# Mesh token (shared across all nodes in the same mesh)
# Generate with: agent-bridge key generate-mesh-token
MESH_TOKEN=

# Data directory for keys.json, grants.json, peers.json
AGENT_BRIDGE_DATA_DIR=.agent-bridge
